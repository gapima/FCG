# Copie este arquivo para .env. O arquivo .env local não deve ser versionado.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=fiap_cloud_games
POSTGRES_PORT=5432

API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
SWAGGER_ENABLED=true

# Use pelo menos 32 bytes. Gere um valor aleatório conforme docs/GUIA-DOCKER.md.
JWT_SIGNING_KEY=troque-por-uma-chave-local-com-pelo-menos-32-bytes
